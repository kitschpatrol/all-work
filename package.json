{
	"name": "allwork",
	"version": "0.0.5",
	"private": true,
	"description": "High-level view of your maintained repositories.",
	"keywords": [
		"github"
	],
	"homepage": "https://github.com/kitschpatrol/allwork",
	"bugs": "https://github.com/kitschpatrol/allwork/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/allwork.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"type": "module",
	"main": "./electron/main.js",
	"scripts": {
		"build": "svelte-kit sync && vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.build.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.build.json --watch",
		"clean": "git rm -f pnpm-lock.yaml ; git clean -fdX",
		"dev": "vite dev --host",
		"electron": "electron .",
		"electron:build": "svelte-kit sync && vite build && electron-builder",
		"fix": "kpi fix",
		"lint": "kpi lint",
		"move": "rm -rf /Applications/AllWork.app ; mv ./dist/mac-arm64/AllWork.app /Applications/AllWork.app",
		"preview": "vite preview",
		"release1": "bumpp --commit 'Release: %s' && pnpm run build",
		"release2": "export GH_TOKEN=$(op read 'op://Personal/Github Mika/PERSONAL_ACCESS_TOKEN') && electron-builder build --publish always",
		"test": "vitest"
	},
	"devDependencies": {
		"@kitschpatrol/shared-config": "^5.5.0",
		"@sveltejs/adapter-node": "^5.2.13",
		"@sveltejs/kit": "^2.26.1",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/postcss": "^4.1.11",
		"autoprefixer": "^10.4.21",
		"bumpp": "^10.2.1",
		"electron": "^36.7.3",
		"electron-builder": "^26.0.12",
		"execa": "^9.6.0",
		"flowbite": "^3.1.2",
		"flowbite-svelte": "^1.10.22",
		"flowbite-svelte-icons": "^2.2.1",
		"globby": "^14.1.0",
		"read-pkg": "^9.0.1",
		"svelte": "^5.37.1",
		"svelte-check": "^4.3.0",
		"tailwindcss": "^4.1.11",
		"taze": "^19.1.0",
		"typescript": "^5.8.3",
		"vite": "^6.3.5",
		"vitest": "^3.2.4",
		"zod": "^3.25.76"
	},
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@sveltejs/kit",
			"@tailwindcss/oxide",
			"electron",
			"electron-winstaller",
			"esbuild",
			"oxc-resolver",
			"puppeteer",
			"unrs-resolver"
		]
	}
}
