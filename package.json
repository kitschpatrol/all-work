{
	"name": "allwork",
	"version": "0.0.4",
	"private": true,
	"description": "High-level view of your maintained repositories.",
	"keywords": [
		"github"
	],
	"homepage": "https://github.com/kitschpatrol/allwork",
	"bugs": "https://github.com/kitschpatrol/allwork/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/allwork.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"type": "module",
	"main": "./electron/main.js",
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.build.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.build.json --watch",
		"clean": "git rm -f pnpm-lock.yaml ; git clean -fdX",
		"dev": "vite dev --host",
		"electron": "electron .",
		"electron:build": "svelte-kit sync && vite build && electron-builder",
		"fix": "kpi fix",
		"lint": "kpi lint",
		"move": "rm -rf /Applications/AllWork.app ; mv ./dist/mac-arm64/AllWork.app /Applications/AllWork.app",
		"preview": "vite preview",
		"test": "vitest"
	},
	"devDependencies": {
		"@kitschpatrol/shared-config": "^5.4.2",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.21.2",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@tailwindcss/postcss": "^4.1.8",
		"autoprefixer": "^10.4.21",
		"electron": "^35.5.1",
		"electron-builder": "^26.0.12",
		"execa": "^9.6.0",
		"flowbite": "^3.1.2",
		"flowbite-svelte": "^1.5.5",
		"flowbite-svelte-icons": "^2.2.0",
		"globby": "^14.1.0",
		"read-pkg": "^9.0.1",
		"svelte": "^5.33.15",
		"svelte-check": "^4.2.1",
		"tailwindcss": "^4.1.8",
		"taze": "^19.1.0",
		"typescript": "^5.8.3",
		"vite": "^6.3.5",
		"vitest": "^3.2.2",
		"zod": "^3.25.56"
	},
	"packageManager": "pnpm@10.11.1",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@sveltejs/kit",
			"@tailwindcss/oxide",
			"electron",
			"electron-winstaller",
			"esbuild",
			"puppeteer",
			"unrs-resolver"
		]
	}
}
