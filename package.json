{
	"name": "allwork",
	"version": "0.0.1",
	"type": "module",
	"description": "High-level view of your maintained repositories.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/allwork.git"
	},
	"homepage": "https://github.com/kitschpatrol/allwork",
	"bugs": {
		"url": "https://github.com/kitschpatrol/allwork/issues",
		"email": "eric@ericmika.com"
	},
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"license": "MIT",
	"private": true,
	"packageManager": "pnpm@9.10.0",
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=9.0.0"
	},
	"keywords": [
		"github"
	],
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"fix": "shared-config --fix",
		"lint": "shared-config --lint",
		"preview": "vite preview",
		"test": "vitest"
	},
	"devDependencies": {
		"@kitschpatrol/shared-config": "^4.7.5",
		"@sveltejs/adapter-auto": "^3.2.4",
		"@sveltejs/kit": "^2.5.26",
		"@sveltejs/vite-plugin-svelte": "^3.1.2",
		"execa": "^9.3.1",
		"globby": "^14.0.2",
		"read-pkg": "^9.0.1",
		"svelte": "^4.2.19",
		"svelte-check": "^4.0.1",
		"typescript": "^5.6.2",
		"vite": "^5.4.4",
		"vitest": "^2.0.5"
	}
}
