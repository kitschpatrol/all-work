{
	"name": "allwork",
	"version": "0.0.1",
	"type": "module",
	"description": "High-level view of your maintained repositories.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/allwork.git"
	},
	"homepage": "https://github.com/kitschpatrol/allwork",
	"bugs": {
		"url": "https://github.com/kitschpatrol/allwork/issues",
		"email": "eric@ericmika.com"
	},
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"license": "MIT",
	"private": true,
	"packageManager": "pnpm@9.10.0",
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=9.0.0"
	},
	"main": "./electron/main.js",
	"keywords": [
		"github"
	],
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"clean": "rimraf pnpm-lock.yaml ; git clean -fdX",
		"dev": "vite dev --host",
		"electron": "electron .",
		"electron:build": "vite build && electron-builder",
		"fix": "shared-config --fix",
		"lint": "shared-config --lint",
		"preview": "vite preview",
		"test": "vitest"
	},
	"devDependencies": {
		"@kitschpatrol/shared-config": "^4.7.5",
		"@sveltejs/adapter-node": "^5.2.2",
		"@sveltejs/kit": "^2.5.26",
		"@sveltejs/vite-plugin-svelte": "^3.1.2",
		"@tailwindcss/typography": "^0.5.15",
		"autoprefixer": "^10.4.20",
		"electron": "^32.1.0",
		"electron-builder": "^25.0.5",
		"execa": "^9.3.1",
		"flowbite": "^2.5.1",
		"flowbite-svelte": "^0.46.16",
		"flowbite-svelte-icons": "^1.6.1",
		"globby": "^14.0.2",
		"npm-check-updates": "^17.1.1",
		"read-pkg": "^9.0.1",
		"rimraf": "^6.0.1",
		"sortable-tablesort": "^3.2.3",
		"svelte": "^4.2.19",
		"svelte-check": "^4.0.2",
		"tailwindcss": "^3.4.11",
		"typescript": "^5.6.2",
		"vite": "^5.4.4",
		"vitest": "^2.1.0"
	}
}
