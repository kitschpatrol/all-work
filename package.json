{
	"name": "allwork",
	"version": "0.0.6",
	"private": true,
	"description": "High-level view of your maintained repositories.",
	"keywords": [
		"github"
	],
	"homepage": "https://github.com/kitschpatrol/allwork",
	"bugs": "https://github.com/kitschpatrol/allwork/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/allwork.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"main": "./electron/main.js",
	"scripts": {
		"build": "svelte-kit sync && vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.build.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.build.json --watch",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"dev": "vite dev --host",
		"electron": "electron .",
		"electron:build": "svelte-kit sync && vite build && electron-builder",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"move": "shx rm -rf /Applications/AllWork.app && shx mv ./dist/mac-arm64/AllWork.app /Applications/AllWork.app",
		"prepare": "skills experimental_sync -y -f",
		"preview": "vite preview",
		"release1": "bumpp --commit 'Release: %s' && pnpm build",
		"release2": "export GH_TOKEN=$(op read 'op://Personal/Github Mika/PERSONAL_ACCESS_TOKEN') && electron-builder build --publish always",
		"test": "vitest run"
	},
	"devDependencies": {
		"@kitschpatrol/shared-config": "^8.12.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.3",
		"autoprefixer": "^10.6.1",
		"bumpp": "^12.3.0",
		"electron": "^44.5.1",
		"electron-builder": "^26.15.3",
		"execa": "^10.1.0",
		"flowbite": "^3.1.2",
		"flowbite-svelte": "^1.33.1",
		"flowbite-svelte-icons": "^3.1.0",
		"globby": "^16.2.4",
		"read-pkg": "^10.1.0",
		"shx": "^0.4.0",
		"skills": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"taze": "^21.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.3",
		"vitest": "^5.0.3",
		"zod": "^4.6.5"
	},
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": "^24.16.0 || >=26.3.0",
		"pnpm": ">=10.0.0"
	}
}
