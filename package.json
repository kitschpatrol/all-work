{
	"name": "all-work",
	"version": "1.0.0",
	"private": true,
	"description": "Parallel command runner and data table to tame and tend your local Git projects.",
	"keywords": [
		"automation",
		"dashboard",
		"git",
		"github",
		"metadata",
		"repository",
		"software-analytics",
		"task-runner",
		"homebrew-formula"
	],
	"homepage": "https://github.com/kitschpatrol/all-work",
	"bugs": "https://github.com/kitschpatrol/all-work/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/all-work.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"main": "./out/main/main.js",
	"scripts": {
		"build": "svelte-kit sync && vite build && electron-vite build",
		"build:electron": "pnpm build && electron-builder",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.build.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.build.json --watch",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"dev": "poptab && vite dev --host 127.0.0.1 --open",
		"dev:electron": "electron-vite dev",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"move": "shx rm -rf '/Applications/All Work.app' && shx mv './dist/mac-arm64/All Work.app' '/Applications/All Work.app'",
		"prepare": "svelte-kit sync",
		"preview": "vite preview",
		"release": "bumpp --commit 'Release: %s' && pnpm build && export GH_TOKEN=$(op read 'op://Personal/Github Mika/PERSONAL_ACCESS_TOKEN') && export APPLE_KEYCHAIN_PROFILE=notarytool && electron-builder build --publish always",
		"start": "node out/main/server.js",
		"test": "vitest run"
	},
	"dependencies": {
		"execa": "^10.2.1",
		"git-url-parse": "^16.1.0",
		"lognow": "^0.8.7",
		"metascope": "^0.13.8"
	},
	"devDependencies": {
		"@kitschpatrol/electron-vite": "6.0.0-fork.1",
		"@kitschpatrol/shared-config": "^8.14.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@tanstack/svelte-table": "^9.3.1",
		"@types/node": "~24.13.6",
		"autoprefixer": "^10.6.2",
		"bumpp": "^12.3.0",
		"electron": "^45.1.0",
		"electron-builder": "^26.18.1",
		"poptab": "^1.2.2",
		"shx": "^0.4.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	},
	"os": [
		"darwin"
	]
}
