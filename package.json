{
	"name": "allwork",
	"version": "0.0.6",
	"private": true,
	"description": "A parallel command line for all your Git repositories.",
	"keywords": [
		"github"
	],
	"homepage": "https://github.com/kitschpatrol/allwork",
	"bugs": "https://github.com/kitschpatrol/allwork/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/allwork.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"main": "./out/main/main.js",
	"scripts": {
		"build": "svelte-kit sync && vite build && electron-vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.build.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.build.json --watch",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"dev": "poptab && vite dev --host 127.0.0.1 --open",
		"dev:electron": "electron-vite dev",
		"electron:build": "pnpm build && electron-builder",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"move": "shx rm -rf /Applications/AllWork.app && shx mv ./dist/mac-arm64/AllWork.app /Applications/AllWork.app",
		"prepare": "svelte-kit sync",
		"preview": "vite preview",
		"release1": "bumpp --commit 'Release: %s' && pnpm build",
		"release2": "export GH_TOKEN=$(op read 'op://Personal/Github Mika/PERSONAL_ACCESS_TOKEN') && electron-builder build --publish always",
		"start": "node out/main/server.js",
		"test": "vitest run"
	},
	"dependencies": {
		"execa": "^10.1.1",
		"git-url-parse": "^16.1.0",
		"lognow": "^0.8.5",
		"metascope": "^0.13.6"
	},
	"devDependencies": {
		"@kitschpatrol/electron-vite": "6.0.0-beta.4",
		"@kitschpatrol/shared-config": "^8.14.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@tanstack/svelte-table": "^9.3.1",
		"@types/node": "^26.6.5",
		"autoprefixer": "^10.6.1",
		"bumpp": "^12.3.0",
		"electron": "^44.7.0",
		"electron-builder": "^26.15.3",
		"poptab": "^1.2.2",
		"shx": "^0.4.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": "^24.16.0 || >=26.3.0",
		"pnpm": ">=10.0.0"
	}
}
